rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ['iamxeshan1@gmail.com', 'prepnextedtech@gmail.com'].hasAny([request.auth.token.email]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExamPurchased(userId, examId) {
      return exists(/databases/$(database)/documents/subscriptions/$(userId + '_' + examId)) &&
             get(/databases/$(database)/documents/subscriptions/$(userId + '_' + examId)).data.paymentStatus == 'completed';
    }

    // Agencies
    match /agencies/{agencyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if true;

      allow create: if isOwner(userId) || isAdmin();

      allow update: if isAdmin() || (
        isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role == resource.data.role)
      );

      allow delete: if isAdmin();
      
      match /pushTokens/{token} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /study_sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /study_planner_items/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Exams
    match /exams/{examId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // LiveTests
    match /liveTests/{testId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledUsers'])
      );
    }
    
    // Coupons
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Tests
    match /tests/{testId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Questions
    match /questions/{questionId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/tests/$(resource.data.testId)) && (
          get(/databases/$(database)/documents/tests/$(resource.data.testId)).data.isFree == true ||
          isExamPurchased(request.auth.uid, get(/databases/$(database)/documents/tests/$(resource.data.testId)).data.examId)
        )) ||
        exists(/databases/$(database)/documents/liveTests/$(resource.data.testId))
      );
      allow write: if isAdmin();
    }

    // Results
    match /results/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Premium Subscriptions
    match /premium_subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if settingId == 'general' || settingId == 'popup_announcement' || isAdmin();
      allow write: if isAdmin();
    }

    // Broadcasting Channels
    match /broadcasting_channels/{channelId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() || (
          isSignedIn() && (
            get(/databases/$(database)/documents/broadcasting_channels/$(channelId)).data.allowAspirantMessages == true ||
            get(/databases/$(database)/documents/broadcasting_channels/$(channelId)).data.whoCanPost == 'everyone'
          )
        );
        allow delete: if isAdmin();
        allow update: if isAdmin() || (
          isSignedIn() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        );
      }
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // Thoughts
    match /thoughts/{thoughtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Study Material
    match /study_material/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Job Alerts
    match /jobAlerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PYQs
    match /pyqs/{pyqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Forum
    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && (
        (resource.data.authorId == request.auth.uid) || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'likeCount', 'likedUsers', 'poll'])
      ));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      }
    }



      


    // Friend Requests
    match /friend_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow read, write: if isSignedIn();
    }

    // Direct Chats (DMs)
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Study Groups
    match /study_groups/{groupId} {
      allow read: if isSignedIn() && (resource == null || resource.data.isPrivate == false || (resource.data != null && 'members' in resource.data && request.auth.uid in resource.data.members) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && (resource == null || (resource.data != null && 'members' in resource.data && request.auth.uid in resource.data.members) || isAdmin());
      allow delete: if isSignedIn() && (resource == null || resource.data.creatorId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
