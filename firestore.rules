rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ['iamxeshan1@gmail.com', 'prepnextedtech@gmail.com'].hasAny([request.auth.token.email]) ||
        (request.auth.token.email != null && ['iamxeshan1@gmail.com', 'prepnextedtech@gmail.com'].hasAny([request.auth.token.email.lower()])) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')) ||
        true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Agencies
    match /agencies/{agencyId} {
      allow read, write: if true;
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
      
      match /pushTokens/{token} {
        allow read, write: if true;
      }
      
      match /study_sessions/{sessionId} {
        allow read, write: if true;
      }

      match /study_planner_items/{itemId} {
        allow read, write: if true;
      }
    }

    // User Messages
    match /user_messages/{messageId} {
      allow read, write: if true;
    }

    // Exams
    match /exams/{examId} {
      allow read, write: if true;
    }

    // LiveTests
    match /liveTests/{testId} {
      allow read, write: if true;
    }
    
    // Coupons
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Tests
    match /tests/{testId} {
      allow read, write: if true;
    }

    // Questions
    match /questions/{questionId} {
      allow read, write: if true;
    }

    // Results
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // Premium Subscriptions
    match /premium_subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Broadcasting Channels
    match /broadcasting_channels/{channelId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Thoughts
    match /thoughts/{thoughtId} {
      allow read, write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Study Material
    match /study_material/{materialId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Job Alerts
    match /jobAlerts/{alertId} {
      allow read, write: if true;
    }

    // PYQs
    match /pyqs/{pyqId} {
      allow read, write: if true;
    }

    // Forum
    match /forum_posts/{postId} {
      allow read, write: if true;
      
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }

    // Direct Chats (DMs)
    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Study Groups
    match /study_groups/{groupId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
