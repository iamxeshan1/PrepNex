rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ['iamxeshan1@gmail.com', 'prepnextedtech@gmail.com'].hasAny([request.auth.token.email]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Agencies
    match /agencies/{agencyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
      
      match /pushTokens/{token} {
        allow read, write: if isSignedIn();
      }
      
      match /study_sessions/{sessionId} {
        allow read, write: if isSignedIn();
      }

      match /study_planner_items/{itemId} {
        allow read, write: if isSignedIn();
      }
    }

    // User Messages
    match /user_messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // Exams
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // LiveTests
    match /liveTests/{testId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }
    
    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tests
    match /tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Questions
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Results
    match /results/{resultId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Premium Subscriptions
    match /premium_subscriptions/{subscriptionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Broadcasting Channels
    match /broadcasting_channels/{channelId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Thoughts
    match /thoughts/{thoughtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Study Material
    match /study_material/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // Job Alerts
    match /jobAlerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PYQs
    match /pyqs/{pyqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Forum
    match /forum_posts/{postId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      
      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn();
      }
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow read, write: if isSignedIn();
    }

    // Direct Chats (DMs)
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Study Groups
    match /study_groups/{groupId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
